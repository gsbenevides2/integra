{
  "name": "@gsbenevides2/integra",
  "displayName": "Integra",
  "description": "Personal home-automation and monitoring server (Bun + Elysia + React) integrating Tuya smart-home devices, a TP-Link router, Google accounts, server/network health, train and platform status, and Discord/Authentik notifications — fully traced end-to-end with OpenTelemetry.",
  "type": "module",
  "version": "2.0.18",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gsbenevides2/integra.git"
  },
  "author": {
    "email": "git@gui.dev.br",
    "name": "Guilherme da Silva Benevides",
    "url": "https://www.gui.dev.br"
  },
  "license": "MIT",
  "scripts": {
    "dev": "bun run --watch server/index.ts",
    "lint": "bun --bun eslint .",
    "lint:fix": "bun --bun eslint . --fix",
    "db:sync": "bun --bun run drizzle-kit push --config server/db/drizzle.config.ts",
    "db:studio": "bun --bun run drizzle-kit studio --config server/db/drizzle.config.ts"
  },
  "dependencies": {
    "@elysia/eden": "^1.4.10",
