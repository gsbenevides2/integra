{
    "name": "@gsbenevides2/integra",
    "displayName": "Integra",
    "description": "Event-driven daemon connecting external services (HTTP, MQTT, Redis, PostgreSQL, Email/IMAP, Cron) to user scripts. Every execution is auto-traced to PostgreSQL.",
    "module": "index.ts",
    "type": "module",
    "version": "1.0.50",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gsbenevides2/integra.git"
    },
    "author": {
        "email": "git@gui.dev.br",
        "name": "Guilherme da Silva Benevides",
        "url": "https://www.gui.dev.br"
    },
    "license": "MIT",
    "scripts": {
        "dev": "concurrently \"bun run dev:css\" \"bun run dev:server\" \"bun run dev:client\"",
        "dev:css": "bunx @tailwindcss/cli -i ./src/input.css -o ./assets/output.css --watch",
        "dev:server": "bun run --watch src/index.ts --disableCrons",
        "dev:client": "bun build --watch src/core/ui/client-bundle.tsx src/core/ui/sw.ts src/core/opentelemetry/frontend.ts --outdir assets --minify --sourceap=inline",
        "build": "bun run build:css && bun run build:server && bun run build:client",
        "build:css": "bunx @tailwindcss/cli -i ./src/input.css -o ./assets/output.css  --minify",
        "build:server": "bun build src/index.ts --outdir dist --target bun --sourcemap=external",
        "build:client": "bun build src/core/ui/client-bundle.tsx src/core/ui/sw.ts src/core/opentelemetry/frontend.ts --outdir assets --minify --sourceap=inline",
        "install-deps": "export GITHUB_TOKEN=$(gh auth token) && bun install",
        "db:sync": "bun --bun run drizzle-kit push --config src/core/db/drizzle.config.ts",
        "db:studio": "bun --bun run drizzle-kit studio --config src/core/db/drizzle.config.ts",
        "lint": "bun --bun eslint .",
        "lint:fix": "bun --bun eslint . --fix",
        "format": "bun --bun prettier --check .",
        "format:fix": "bun --bun prettier --write .",
        "test": "bun test"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@types/imap": "^0.8.43",
        "@types/mailparser": "^3.4.6",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@types/ssh2": "^1.15.5",
        "@types/ws": "^8.18.1",
        "concurrently": "^10.0.5",
        "drizzle-kit": "^1.0.0-rc.4",
        "eslint": "^10.6.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.8.5",
        "typescript-eslint": "^8.62.0"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "dependencies": {
        "@elysia/eden": "^1.4.10",
        "@elysia/openapi": "^1.4.15",
        "@heroicons/react": "^2.2.0",
        "@modelcontextprotocol/sdk": "^1.29.0",
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/context-async-hooks": "^1.30.1",
        "@opentelemetry/context-zone": "^2.11.0",
        "@opentelemetry/core": "^2.11.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.57.2",
        "@opentelemetry/instrumentation": "^0.57.2",
        "@opentelemetry/instrumentation-document-load": "^0.67.0",
        "@opentelemetry/instrumentation-fetch": "^0.222.0",
        "@opentelemetry/instrumentation-user-interaction": "^0.66.0",
        "@opentelemetry/instrumentation-xml-http-request": "^0.222.0",
        "@opentelemetry/resources": "^1.30.1",
        "@opentelemetry/sdk-node": "^0.57.2",
        "@opentelemetry/sdk-trace-base": "^1.30.1",
        "@opentelemetry/sdk-trace-web": "^2.11.0",
        "@opentelemetry/semantic-conventions": "^1.43.0",
        "@tailwindcss/cli": "^4.3.3",
        "@textea/json-viewer": "^4.0.1",
        "@tuya/tuya-connector-nodejs": "^2.1.2",
        "@types/crypto-js": "^4.2.2",
        "axios": "^1.20.0",
        "crypto-js": "^4.2.0",
        "date-fns": "^4.4.0",
        "date-fns-tz": "^3.2.0",
        "drizzle-orm": "^1.0.0-rc.4",
        "elysia": "^1.4.29",
        "googleapis": "^178.1.1",
        "happy-dom": "^20.14.3",
        "imap": "^0.8.19",
        "jose": "^6.2.3",
        "mac-oui-lookup": "^1.1.4",
        "mailparser": "^3.9.12",
        "mqtt": "^5.15.1",
        "openai": "^6.45.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "recharts": "^3.10.1",
        "ssh2": "^1.17.0",
        "tailwindcss": "^4.3.3",
        "ws": "^8.21.3",
        "zod": "^4.5.4"
    }
}
