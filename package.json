{
    "name": "@gsbenevides2/integra",
    "displayName": "Integra",
    "description": "Event-driven daemon connecting external services (HTTP, MQTT, Home Assistant, Redis, PostgreSQL, Email/IMAP, Cron) to user scripts. Every execution is auto-traced to MongoDB.",
    "module": "index.ts",
    "type": "module",
    "version": "1.0.6",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gsbenevides2/integra.git"
    },
    "author": {
        "email": "git@gui.dev.br",
        "name": "Guilherme da Silva Benevides",
        "url": "https://www.gui.dev.br"
    },
    "license": "MIT",
    "scripts": {
        "start": "bun run src/index.ts",
        "build": "bun build src/index.ts --outdir dist --target bun --sourcemap=external",
        "install-deps": "export GITHUB_TOKEN=$(gh auth token) && bun install",
        "lint": "bun --bun eslint .",
        "lint:fix": "bun --bun eslint . --fix",
        "format": "bun --bun prettier --check .",
        "format:fix": "bun --bun prettier --write ."
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@types/imap": "^0.8.43",
        "@types/mailparser": "^3.4.6",
        "@types/ssh2": "^1.15.5",
        "eslint": "^10.6.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.8.5",
        "typescript-eslint": "^8.62.0"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "dependencies": {
        "@elysia/eden": "^1.4.10",
        "@elysia/openapi": "^1.4.15",
        "@gsbenevides2/http-scheduller": "^1.0.17",
        "@gsbenevides2/tp-link-center": "^0.0.26",
        "@modelcontextprotocol/sdk": "^1.29.0",
        "bson": "7.2.0",
        "date-fns": "^4.4.0",
        "date-fns-tz": "^3.2.0",
        "elysia": "^1.4.29",
        "imap": "^0.8.19",
        "jose": "^6.2.3",
        "mailparser": "^3.9.12",
        "mongoose": "^9.7.3",
        "mqtt": "^5.15.1",
        "openai": "^6.45.0",
        "ssh2": "^1.17.0",
        "zod": "^4.4.3"
    }
}
