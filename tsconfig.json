{
  "compilerOptions": {
    "target": "ES2021",
    "jsx": "preserve",
    "module": "ES2022",
    "lib": ["es2022"],
    "moduleResolution": "node",
    "types": ["bun-types"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@server": ["./server/index.ts"],
      "@server/*": ["./server/*"],
      "@public/*": ["./public/*"],
      "@/package.json": ["./package.json"]
    }
  }
}
